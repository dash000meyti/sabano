# Public origin used for canonical URLs, sitemap and JSON-LD
SITE_URL=https://sabano.ir

# Persistent data (SQLite db, uploads, media, backups). Defaults to <repo>/data in dev.
# DATA_DIR=/data

# Long random string (keys the IP hashes used for rate limiting). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# First admin, created on startup only if no users exist yet.
# Use a strong password (12+ characters); placeholders like the one below are refused.
# ADMIN_EMAIL=admin@sabano.ir
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=مدیر سایت

# Optional e-mail notification for new form submissions
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Sabano Website <no-reply@sabano.ir>"
# NOTIFY_EMAIL=info@sabano.ir

# Optional: IndexNow key (Bing, Yandex…) – any 8–128 char hex/alnum string
# INDEXNOW_KEY=

# Optional search engine verification codes
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# YANDEX_VERIFICATION=

# --- Local development & tests ---------------------------------------------
# Create a throwaway admin for your local database with `pnpm admin:create`, then
# run the admin e2e tests with these set (keep real values in a git-ignored .env.local):
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
